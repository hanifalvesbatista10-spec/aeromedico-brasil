# Supabase — projeto do CMS (ver supabase/migrations e supabase/admin-bootstrap.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (opcional — o script só é renderizado se a variável existir)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Frete automático — Melhor Envio (SOMENTE servidor: nunca use o prefixo NEXT_PUBLIC)
# Sem as três primeiras (token, CEP de origem e e-mail), o carrinho não calcula frete e o
# frete é combinado no WhatsApp. MELHOR_ENVIO_ENV é opcional (padrão: sandbox).
MELHOR_ENVIO_TOKEN=
# "production" para a conta real; qualquer outro valor (ou vazio) usa o sandbox
MELHOR_ENVIO_ENV=sandbox
# CEP de onde a loja despacha (8 dígitos, com ou sem hífen)
STORE_ORIGIN_CEP=
# E-mail técnico exigido pela API no cabeçalho User-Agent
MELHOR_ENVIO_CONTACT_EMAIL=
